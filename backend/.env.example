# Copy this to .env and fill in your values

# Database (SQLite file path — keep as-is for local dev)
DATABASE_URL="file:./prisma/dev.db"

# JWT secret — CHANGE THIS to a long random string in production!
JWT_SECRET="change-me-to-a-long-random-secret-string"

# Server port (Railway/Render set this automatically)
PORT=4002

# Set to "production" when deploying live
NODE_ENV=development
